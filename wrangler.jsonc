/**
 * Deploys to Cloudflare Workers. Every page is prerendered, so the Worker serves static files,
 * and passes `/api/` on to the share Worker (`share/`). The share Worker keeps its name from before
 * Flint was named: it holds shared bills, and renaming it would put them at risk.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "itrium-website-flint",
	"compatibility_date": "2026-10-07",
	"compatibility_flags": ["nodejs_compat"],
	// The adapter sets the Worker's entry and where its files are, in the configuration it writes
	// for the build (`.svelte-kit/cloudflare/worker/wrangler.json`), which Wrangler deploys from.
	"assets": { "binding": "ASSETS" },
	// Creates the DNS record for flint.itrium.id.
	"routes": [{ "pattern": "flint.itrium.id", "custom_domain": true }],
	// The share Worker, which has no address of its own. Previews don't inherit bindings, so they
	// get the same one below.
	"services": [{ "binding": "SHARE", "service": "itrium-backend-tools" }],
	// No logs of visitors' requests are kept.
	"observability": { "enabled": false },
	// Cloudflare builds each pull request's branch as a Preview (`wrangler preview`), which fails
	// without this block. Previews keep no visitor logs either.
	"previews": {
		"observability": { "enabled": false },
		"services": [{ "binding": "SHARE", "service": "itrium-backend-tools" }]
	}
}
